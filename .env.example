# Supabase project (Settings -> API). Leave empty to run in guest mode (device-only saves).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only (never prefix with VITE_). Without these, /api runs in demo mode.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional model overrides
# ZABAN_CHAT_MODEL=claude-haiku-5-5
# ZABAN_RATER_MODEL=claude-haiku-5-5
# ZABAN_LEGEND_MODEL=claude-opus-5-5
